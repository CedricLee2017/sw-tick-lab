{
  "name": "sw-tick-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "魔靈召喚 天空之役 — 符文配裝與速度 Tick 實驗室",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "data": "node scripts/build-monsters.mjs",
    "skills": "node scripts/fetch-skills.mjs",
    "demo": "node scripts/build-demo.mjs",
    "set-password": "node scripts/set-password.mjs",
    "test": "node scripts/test-engine.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name sw-tick-lab",
    "dev:api": "npm run build && npx wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
